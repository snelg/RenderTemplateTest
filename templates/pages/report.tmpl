{{template "layout" .}}

{{/* Page blocks */}}
{{define "title"}}Users & Orders{{end}}

{{/*Lets you override the "content" block in the layout */}}
{{define "content"}}
    {{with .UsersTable}}
        {{template "table/start" .}}
        {{range .Rows}}
            <tr>
                <td>{{.Name}}</td>
                <td>{{.Email}}</td>
            </tr>
        {{end}}
        {{template "table/end" .}}
    {{end}}

    <p>Between…</p>

    {{template "table/start" .OrdersTable}}
    {{range .OrdersTable.Rows}}
        <tr>
            <td>{{.ID}}</td>
            <td>{{.Total}}</td>
        </tr>
    {{end}}
    {{template "table/end" .}}
{{end}}
