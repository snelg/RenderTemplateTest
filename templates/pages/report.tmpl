{{/* gotype: TableRenderTest.PageData */}}
{{define "title"}}Users & Orders{{end}}

{{/* main content */}}
{{template "layout/START" .}}

    {{with .UsersTable}}
        {{template "table/START" .}}
        {{range .Rows}}
            <tr>
                <td>{{.Name}}</td>
                <td>{{.Email}}</td>
            </tr>
        {{end}}
        {{template "table/END" .}}
    {{end}}

    <p>Between…</p>

    {{template "table/START" .OrdersTable}}
    {{range .OrdersTable.Rows}}
        <tr>
            <td>{{.ID}}</td>
            <td>{{.Total}}</td>
        </tr>
    {{end}}
    {{template "table/END" .}}

{{template "layout/END" .}}
